# Binaries and executables
*.exe
*.dll
*.so
/orchestrator
/backend/orchestrator/orchestrator

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

